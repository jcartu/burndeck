# burndeck.service -- systemd unit template.
#
# Generated by scripts/install.sh (--systemd). install.sh sed-replaces the
# __USER__ and __REPO__ placeholders below and writes the result to
# /etc/systemd/system/burndeck.service; with --mock N it also appends an
# Environment=BURNDECK_MOCK_GPUS=N line. Edit the rendered copy for per-host
# tuning, not this template.

[Unit]
Description=Burndeck GPU + LLM dashboard
Documentation=https://github.com/jcartu/burndeck
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__REPO__
ExecStart=__REPO__/.venv/bin/python __REPO__/app.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=mixed

# Uncomment / edit to override config.toml defaults.
#Environment=BURNDECK_HOST=127.0.0.1
#Environment=BURNDECK_PORT=8801
#Environment=BURNDECK_GPU_POLL_SECONDS=0.25
#Environment=BURNDECK_LLM_POLL_SECONDS=1.0

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
